{
  "packageId": "ttg.pattern.agent-accountability-edge",
  "evidenceArtifacts": [
    {
      "id": "evidence.agent.accountability.edge",
      "artifactType": "tis-evidence-bundle-manifest",
      "description": "Evidence bundle for Agent Accountability Edge.",
      "supportsRefs": [
        "policy.agent.accountability.edge",
        "decision.agent.accountability.edge",
        "control.scoped-agent-mandate",
        "control.controller-traceability",
        "control.pre-effect-decision-receipt"
      ]
    }
  ],
  "tisArtifactProjection": {
    "authorityBoundary": "governance/authority-boundary.schema.json",
    "evidenceBundle": "evidence/evidence-bundle-manifest.schema.json",
    "evaluationEnvelope": "oasf/oasf-evaluation-envelope.schema.json",
    "decisionReceipt": "decision/decision-receipt.schema.json",
    "registryPublicationProfile": "registry/registry-publication-profile.schema.json"
  },
  "verificationExpectations": [
    {
      "id": "assessment.agent.accountability.edge",
      "method": "tsmm-tis-runtime-assurance-check",
      "performedBy": "assurance reviewer or automated validator",
      "controlRefs": [
        "control.scoped-agent-mandate",
        "control.controller-traceability",
        "control.pre-effect-decision-receipt"
      ],
      "inputRefs": [
        "evidence.agent.accountability.edge",
        "policy.agent.accountability.edge"
      ]
    }
  ],
  "decisionReceipts": [
    {
      "id": "decision.agent.accountability.edge",
      "policyRef": "policy.agent.accountability.edge",
      "verificationRefs": [
        "assessment.agent.accountability.edge"
      ],
      "effectRefs": [
        "effect.admit-agent-action",
        "effect.block-orphan-action",
        "effect.escalate-high-risk-action"
      ],
      "requiredFields": [
        "actor",
        "authority_boundary",
        "policy_evaluated",
        "evidence_bundle",
        "revocation_or_status_check",
        "outcome",
        "effect_admission",
        "redress_route",
        "timestamp"
      ]
    }
  ]
}
