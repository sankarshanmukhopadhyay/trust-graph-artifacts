{
  "packageId": "ttg.profile.situated.knowledge.infrastructure.profile",
  "kind": "profile",
  "controlSet": [
    {
      "id": "control.classification-criteria",
      "type": "governance-control",
      "description": "Apply explicit situated-knowledge dependency criteria."
    },
    {
      "id": "control.protection-lifecycle",
      "type": "governance-control",
      "description": "Provide protected, review, suspension, withdrawal, and retirement states."
    },
    {
      "id": "control.appeal-and-revalidation",
      "type": "governance-control",
      "description": "Provide appeal, periodic revalidation, and revocation."
    },
    {
      "id": "control.change-impact-gate",
      "type": "governance-control",
      "description": "Require an epistemic impact assessment before material change."
    }
  ],
  "policyRules": [
    {
      "policyId": "policy.situated.knowledge.infrastructure.profile",
      "rules": [
        "Apply explicit situated-knowledge dependency criteria.",
        "Provide protected, review, suspension, withdrawal, and retirement states.",
        "Provide appeal, periodic revalidation, and revocation.",
        "Require an epistemic impact assessment before material change."
      ]
    }
  ],
  "threats": [
    {
      "id": "threat.epistemic-blindness",
      "type": "governance-risk",
      "description": "A legitimate and well-recorded decision proceeds without access to materially relevant situated knowledge."
    },
    {
      "id": "threat.knowledge-path-capture",
      "type": "capture-risk",
      "description": "The authority controlling the proposed effect also controls the channels used to certify epistemic adequacy."
    },
    {
      "id": "threat.receipt-completeness-confusion",
      "type": "assurance-risk",
      "description": "A complete decision receipt is incorrectly treated as proof that all relevant knowledge was discoverable."
    }
  ],
  "lifecycle": {
    "states": [
      "not-assessed",
      "assessment-required",
      "knowledge-path-incomplete",
      "challenge-open",
      "adequate",
      "override-invoked",
      "expired",
      "retired"
    ],
    "transitions": [
      {
        "id": "transition.assess",
        "from": "state.not-assessed",
        "to": "state.assessment-required",
        "trigger": "qualifying effect proposed",
        "actor": "decision authority",
        "evidenceRequirement": "effect and scope declaration"
      },
      {
        "id": "transition.challenge",
        "from": "state.assessment-required",
        "to": "state.challenge-open",
        "trigger": "material knowledge-path gap or qualifying objection",
        "actor": "knowledge bearer or challenge authority",
        "evidenceRequirement": "challenge receipt"
      },
      {
        "id": "transition.adequate",
        "from": "state.assessment-required",
        "to": "state.adequate",
        "trigger": "independent assessment completed",
        "actor": "independent assessor",
        "evidenceRequirement": "epistemic impact assessment"
      },
      {
        "id": "transition.override",
        "from": "state.challenge-open",
        "to": "state.override-invoked",
        "trigger": "bounded emergency override",
        "actor": "override authority",
        "evidenceRequirement": "override receipt and retrospective review"
      },
      {
        "id": "transition.expire",
        "from": "state.adequate",
        "to": "state.expired",
        "trigger": "validity period elapsed or material conditions changed",
        "actor": "system or assessor",
        "evidenceRequirement": "freshness evidence"
      }
    ]
  },
  "notes": [
    "Epistemic adequacy is a bounded assurance conclusion, not a guarantee of complete knowledge or correct outcome.",
    "Authority, delegation, enforcement, expiry, override, and redress remain explicit."
  ]
}
