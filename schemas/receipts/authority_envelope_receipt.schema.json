{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-graph-artifacts/main/schemas/receipts/authority_envelope_receipt.schema.json",
  "title": "Runtime Authority Envelope Receipt",
  "description": "Evidence receipt proving that a consequential agent action was evaluated against actor, controller, principal, mandate, scope, policy, evidence, revocation state, decision record, and redress route at execution time.",
  "type": "object",
  "required": [
    "receiptId",
    "receiptType",
    "timestamp",
    "sourceEssays",
    "technicalActorRef",
    "accountableControllerRef",
    "principalRef",
    "mandateRef",
    "scopeBoundary",
    "policyVersion",
    "evidenceRefs",
    "revocationStateChecked",
    "decisionReceiptRef",
    "redressRoute",
    "executionContext",
    "assurancePosture",
    "outcome"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "pattern": "^urn:tga:receipt:authority-envelope:.+"
    },
    "receiptType": {
      "const": "authority-envelope-receipt"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceEssays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "publishedDate"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publishedDate": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "technicalActorRef": {
      "type": "string",
      "minLength": 1
    },
    "accountableControllerRef": {
      "type": "string",
      "minLength": 1
    },
    "principalRef": {
      "type": "string",
      "minLength": 1
    },
    "mandateRef": {
      "type": "string",
      "minLength": 1
    },
    "scopeBoundary": {
      "type": "object",
      "required": [
        "temporal",
        "purpose",
        "jurisdiction",
        "transaction",
        "riskTier"
      ],
      "properties": {
        "temporal": {
          "type": "object",
          "required": [
            "notBefore",
            "notAfter"
          ],
          "properties": {
            "notBefore": {
              "type": "string",
              "format": "date-time"
            },
            "notAfter": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "purpose": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "jurisdiction": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "transaction": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "riskTier": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        }
      },
      "additionalProperties": false
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "revocationStateChecked": {
      "type": "object",
      "required": [
        "checked",
        "authorityState",
        "checkedAt",
        "registryRef",
        "cacheAgeSeconds",
        "maxCacheAgeSeconds"
      ],
      "properties": {
        "checked": {
          "const": true
        },
        "authorityState": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "revoked",
            "expired",
            "stale",
            "orphaned",
            "unknown"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "registryRef": {
          "type": "string",
          "minLength": 1
        },
        "cacheAgeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "maxCacheAgeSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "decisionReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "redressRoute": {
      "type": "object",
      "required": [
        "routeRef",
        "availableTo",
        "remedyClasses",
        "humanReviewAvailable"
      ],
      "properties": {
        "routeRef": {
          "type": "string"
        },
        "availableTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "remedyClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "humanReviewAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "executionContext": {
      "type": "object",
      "required": [
        "requestedEffect",
        "executionNode",
        "decisionMode",
        "highConsequence"
      ],
      "properties": {
        "requestedEffect": {
          "type": "string"
        },
        "executionNode": {
          "type": "string"
        },
        "decisionMode": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "review",
            "suspend",
            "escalate"
          ]
        },
        "highConsequence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "assurancePosture": {
      "type": "object",
      "required": [
        "level",
        "failMode",
        "conformanceChecks"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "AL1",
            "AL2",
            "AL3",
            "AL4"
          ]
        },
        "failMode": {
          "type": "string",
          "enum": [
            "fail-closed",
            "fail-open-with-review",
            "monitor-only"
          ]
        },
        "conformanceChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "review",
        "suspend",
        "escalate"
      ]
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
